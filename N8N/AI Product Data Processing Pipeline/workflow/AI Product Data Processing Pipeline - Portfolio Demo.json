    {
      "parameters": {
        "jsCode": "const EUR_TO_PLN_RATE = 4.35;\n\nconst fields = [\n  'code',\n  'image',\n  'pdf',\n  'description mktg',\n  'collection mktg',\n  'surfaces NEW',\n  'thickness \"mm\"',\n  'UM',\n  'pcs/box',\n  'mq/box',\n  'kg/box',\n  'kg/UM',\n  'kg/pall',\n  'box/pall',\n  'mq/pall',\n  'size\"cm\"',\n  'price',\n  'EAN',\n  'frost_resistance',\n  'application',\n  'rectified',\n  'abrasion_resistance',\n  'material'\n];\n\nconst keyMap = {\n  'description mktg': 'description_mktg',\n  'collection mktg': 'collection_mktg',\n  'surfaces NEW': 'surfaces_NEW',\n  'thickness \"mm\"': 'thickness_mm',\n  'pcs/box': 'pcs_box',\n  'mq/box': 'mq_box',\n  'kg/box': 'kg_box',\n  'kg/UM': 'kg_UM',\n  'kg/pall': 'kg_pall',\n  'box/pall': 'box_pall',\n  'mq/pall': 'mq_pall',\n  'size\"cm\"': 'size_cm'\n};\n\nreturn items.map(item => {\n  const product = {};\n\n  for (const field of fields) {\n    const value = item.json[field];\n\n    if (value === undefined || value === null) {\n      continue;\n    }\n\n    if (field === 'price') {\n      const normalizedPrice = String(value).replace(',', '.');\n      const priceEUR = parseFloat(normalizedPrice);\n\n      if (!Number.isNaN(priceEUR)) {\n        product.price_PLN = (priceEUR * EUR_TO_PLN_RATE).toFixed(2);\n      }\n\n      continue;\n    }\n\n    const outputKey = keyMap[field] || field;\n    product[outputKey] = value;\n  }\n\n  return {\n    json: product\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -784
      ],
      "id": "4fd5ad9c-3340-48c0-8197-96bc331a1c46",

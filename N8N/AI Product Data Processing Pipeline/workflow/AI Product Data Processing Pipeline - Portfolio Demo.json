        -592
      ],
      "id": "0808fd43-7a8e-4f6b-a465-f29d7d62664f",
      "name": "Stop Processing - Invalid File"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const rawOutput = item.json.output ?? item.json.data;\n\n  let parsedOutput = {};\n\n  if (rawOutput) {\n    try {\n      parsedOutput =\n        typeof rawOutput === 'string'\n          ? JSON.parse(rawOutput)\n          : rawOutput;\n    } catch (error) {\n      parsedOutput = {};\n    }\n  }\n\n  const {\n    output,\n    data,\n    prompt,\n    ...productData\n  } = item.json;\n\n  const opisKrotki =\n    typeof parsedOutput.opis_krotki === 'string'\n      ? parsedOutput.opis_krotki\n      : '';\n\n  const opisDlugi =\n    typeof parsedOutput.opis_dlugi === 'string'\n      ? parsedOutput.opis_dlugi\n      : '';\n\n  return {\n    json: {\n      ...productData,\n      opis_krotki: opisKrotki,\n      opis_dlugi: opisDlugi\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2112,
        -784
      ],
      "id": "d21aaeb1-6895-4aba-9e42-33c84c702559",
      "name": "Parse AI Response"

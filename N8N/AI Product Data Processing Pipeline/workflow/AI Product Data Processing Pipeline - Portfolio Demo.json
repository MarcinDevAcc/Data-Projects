        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"opis_krotki\": {\n      \"type\": \"string\"\n    },\n    \"opis_dlugi\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"opis_krotki\",\n    \"opis_dlugi\"\n  ],\n  \"additionalProperties\": false\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
